SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:3000
# true solo en tu .env.local: activa /api/v1/dev/* (bots de prueba). En Vercel no se define.
ENABLE_DEV_ROUTES=false
# NEXT_PUBLIC_API_MOCK=1   # solo Jose, mientras no exista la API
# Solo para el timbre en tiempo real. La clave anon es pública: RLS sin políticas impide leer tablas con ella.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AI Coach (solo servidor; nunca NEXT_PUBLIC_). Sin estas tres, el coach escribe con plantillas.
COACH_LLM_BASE_URL=
COACH_LLM_MODEL=
COACH_LLM_API_KEY=
# Opcionales
# 1 = manda response_format json_object (solo si el proveedor lo acepta)
COACH_LLM_JSON_MODE=0
# Por llamada (máx. 2 llamadas)
COACH_LLM_TIMEOUT_MS=15000
# En modelos que "piensan", el razonamiento cuenta aquí
COACH_LLM_MAX_TOKENS=1500
# off = no se manda (algunos modelos de razonamiento solo aceptan el valor por defecto)
COACH_LLM_TEMPERATURE=0.4
# none | minimal | low | medium | high (solo si el modelo lo acepta)
COACH_LLM_REASONING_EFFORT=
